@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

set(OpenMeta_ABI_VERSION "@OPENMETA_ABI_VERSION@")
set(OpenMeta_CXX_STDLIB "toolchain-default")
set(OpenMeta_MSVC_RUNTIME_LIBRARY "@CMAKE_MSVC_RUNTIME_LIBRARY@")

if(@OPENMETA_CONFIG_USE_LIBCXX@)
  set(OpenMeta_CXX_STDLIB "libc++")
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    set(OpenMeta_FOUND FALSE)
    set(OpenMeta_NOT_FOUND_MESSAGE
      "OpenMeta was built with libc++; use a Clang consumer toolchain or install a matching OpenMeta package.")
    return()
  endif()
endif()

if(@OPENMETA_CONFIG_HAS_STATIC_TARGET@)
  if(@OPENMETA_CONFIG_HAS_ZLIB@)
    find_dependency(ZLIB)
  endif()

  if(@OPENMETA_CONFIG_HAS_BROTLI@)
    find_dependency(Brotli)
  endif()

  if(@OPENMETA_CONFIG_HAS_EXPAT@)
    find_dependency(EXPAT)
  endif()

  if(@OPENMETA_CONFIG_HAS_OPENSSL@)
    find_dependency(OpenSSL)
  endif()

  if(@OPENMETA_CONFIG_HAS_DNG_SDK@)
    find_dependency(dng_sdk CONFIG)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OpenMetaTargets.cmake")

# Convenience alias: prefer shared when available, otherwise fall back to static.
if(NOT TARGET OpenMeta::openmeta)
  if(TARGET OpenMeta::openmeta_shared)
    add_library(OpenMeta::openmeta ALIAS OpenMeta::openmeta_shared)
  elseif(TARGET OpenMeta::openmeta_static)
    add_library(OpenMeta::openmeta ALIAS OpenMeta::openmeta_static)
  endif()
endif()
